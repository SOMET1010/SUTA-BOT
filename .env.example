# =============================================================================
# SUTA — Configuration d'environnement (exemple)
# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne JAMAIS committer de vraies valeurs (clés, secrets, mots de passe).
# =============================================================================

# --- Application ---------------------------------------------------------
NODE_ENV=development
# development | staging | production | demo
APP_ENV=development
APP_URL=http://localhost:3000

# --- Fournisseur IA Realtime ----------------------------------------------
# Sélectionne l'implémentation de RealtimeProvider utilisée par le backend.
# azure | openai | mock
AI_PROVIDER=mock

# Nom du modèle et du déploiement Realtime, confirmés par l'équipe IT/PIE
# (cahier des charges, section 67) : modèle/déploiement "gpt-realtime-2.1".
# Laissé vide ici (fichier d'exemple) — renseigner dans .env.local.
REALTIME_MODEL=
# Voix de synthèse Realtime (défaut : cedar — voix masculine naturelle du
# modèle GA, alignée sur le visuel de référence de SUTA ; « marin » pour la
# variante féminine)
REALTIME_VOICE=cedar
REALTIME_DEPLOYMENT=

# --- Azure OpenAI / Azure AI Foundry --------------------------------------
# Ressource confirmée par l'équipe IT/PIE (section 67) :
# endpoint https://dtdi-openai-audio-01.openai.azure.com/ — authentification
# par clé API (AZURE_OPENAI_API_KEY, jamais committée). Renseigner dans
# .env.local uniquement.
# Le nom du déploiement va dans REALTIME_DEPLOYMENT ci-dessus (pas ici) :
# c'est la seule variable lue par le code pour le déploiement Azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REGION=

# --- Azure Speech (lot 3 : voix native SUTA — tests « Jùlaba ») ------------
# Ressource confirmée par l'IT le 24/08 : DTDI-AZURESPEECH-SUTA-01
# (groupe ANSUT-DTDI, région westeurope). Séparée du modèle Realtime.
# La clé vit ici et dans Vercel — JAMAIS dans le navigateur ni dans un chat.
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Voix de synthèse : audible dans /admin/voice-lab, puis sur le site une fois
# VOICE_ENGINE basculé. Vide = fr-FR-DeniseNeural (voix française standard,
# la « bouche de test ») ; plus tard, le nom de la voix custom Jùlaba.
AZURE_SPEECH_VOICE=

# --- Azure Maps (fond de carte + géocodage des localités) ------------------
# Ressource confirmée par l'IT le 24/08 : dtdi-suta-maps-01 (groupe
# ANSUT-DTDI, niveau Gen2) — réponse au retour de la direction : « la carte
# est générique ». La clé ne quitte jamais le serveur (relais /api/map/tile
# et /api/map/geocode). Vide = la carte garde son fond OpenStreetMap actuel.
AZURE_MAPS_KEY=

# --- Moteur de la voix du site (interrupteur du lot 3) ---------------------
# realtime (défaut) : conversation gpt-realtime actuelle, voix « marin ».
# azure-tts : cerveau en texte + bouche Azure Speech (lot 3, en chantier).
# Toute autre valeur retombe sur realtime — le déploiement du lot 3 est
# inerte tant que cette variable n'est pas explicitement basculée.
VOICE_ENGINE=realtime

# --- OpenAI (environnement de développement autorisé uniquement) ----------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=

# --- Fournisseur d'embeddings (base de connaissances / RAG) ----------------
# Sélectionne l'implémentation d'EmbeddingsProvider (packages/knowledge).
# azure | openai | mock
EMBEDDINGS_PROVIDER=mock
# Dimension des vecteurs — doit correspondre à la colonne pgvector
# `document_chunks.embedding` (packages/database/prisma/schema.prisma).
EMBEDDING_DIMENSIONS=1536
# Nom du déploiement/modèle d'embedding (à confirmer par l'équipe IT/PIE).
EMBEDDINGS_DEPLOYMENT=
EMBEDDINGS_MODEL=

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://suta:suta@localhost:5432/suta
# Prioritaire sur DATABASE_URL quand elle est renseignée. À n'utiliser que sur
# un hébergeur où une intégration de base de données impose son propre
# DATABASE_URL au déploiement (cas de l'intégration Neon sur Vercel, qui
# écrase la variable du projet) : ce nom-là n'appartient qu'à SUTA.
SUTA_DATABASE_URL=

# --- PRODUCTION (Vercel) : la recherche citoyenne passe par Supabase -------
# Constat de salon (22/08/2026) : tous les checks au vert, et SUTA répondait
# pourtant depuis les fichiers fictifs de /data/demo — la base Neon injectée
# par Vercel, pas le corpus. Depuis, la recherche citoyenne n'interroge PLUS
# la base locale : /api/tools/search-knowledge appelle l'Edge Function
# Supabase `search-knowledge`, qui vit du même côté que le corpus (même base,
# même modèle d'embedding). AUCUNE variable n'est requise sur Vercel pour ce
# chemin : l'URL du projet et la clé publiable (conçue pour être exposée,
# tables verrouillées par RLS) sont dans apps/web/src/lib/supabase-edge.ts,
# surchargées au besoin par SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY.
# Le chemin Prisma local reste le secours (dev hors ligne) et sert toujours
# /admin (ingestion, diagnostics).
# Vérification après redéploiement : /api/health doit rendre
# `rechercheCorpus: true`.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# --- Salon / Démonstration --------------------------------------------------
# Bascule le démonstrateur sur MockRealtimeProvider si Azure est indisponible.
DEMO_FALLBACK_MODE=true
# Efface automatiquement la conversation après une période d'inactivité (ms).
KIOSK_IDLE_RESET_MS=120000

# Encart événement (écran d'accueil) — jamais de valeur inventée : masqué
# tant que SALON_EVENT_ENABLED n'est pas explicitement "true".
SALON_EVENT_ENABLED=false
SALON_EVENT_NAME=
SALON_EVENT_LOCATION=
SALON_EVENT_START_DATE=
SALON_EVENT_END_DATE=

# --- Administration (/admin) ------------------------------------------------
# Contrôle d'accès minimal (pas l'authentification Entra ID de la phase 2,
# section 57) : un mot de passe partagé protège /admin. Laisser vide
# désactive complètement /admin (défaut sûr — jamais ouvert par accident).
ADMIN_PASSWORD=
# Second mot de passe, pour les équipes — mêmes droits, mais révocable
# indépendamment (changer cette variable coupe l'accès des équipes sans
# toucher au mot de passe principal). Optionnel ; ADMIN_PASSWORD reste requis.
ADMIN_PASSWORD_EQUIPE=
# Secret de signature des sessions admin. Si vide, dérivé d'ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# --- Observabilité -----------------------------------------------------
LOG_LEVEL=info
